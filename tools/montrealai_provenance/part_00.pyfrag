def now_utc() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def write_json(path: Path, obj: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(obj, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def write_csv(path: Path, rows: list[dict[str, Any]], fields: list[str] | None = None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if fields is None:
        fields = list(rows[0].keys()) if rows else []
    with path.open("w", encoding="utf-8", newline="") as f:
        w = csv.DictWriter(f, fieldnames=fields, extrasaction="ignore")
        w.writeheader()
        w.writerows(rows)


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def norm_address(value: Any) -> str | None:
    if isinstance(value, dict):
        return norm_address(value.get("address") or value.get("hash") or value.get("address_hash"))
    if not isinstance(value, str):
        return None
    v = value.strip().lower()
    return v if re.fullmatch(r"0x[0-9a-f]{40}", v) else None


def json_get(obj: Any, *path: str, default: Any = None) -> Any:
    cur = obj
    for key in path:
        if not isinstance(cur, dict):
            return default
        cur = cur.get(key)
    return default if cur is None else cur


def request_with_retry(method: str, url: str, **kwargs: Any) -> requests.Response:
    last: Exception | None = None
    for attempt in range(HTTP_RETRIES + 1):
        try:
            r = SESSION.request(method, url, timeout=HTTP_TIMEOUT, **kwargs)
            if r.status_code in (408, 425, 429) or r.status_code >= 500:
                raise RuntimeError(f"HTTP {r.status_code}: {r.text[:300]}")
            r.raise_for_status()
            return r
        except Exception as exc:
            last = exc
            if attempt == HTTP_RETRIES:
                break
            time.sleep(min(30.0, 0.75 * (2 ** attempt)))
    raise RuntimeError(f"{method} {url} failed after retries: {last}")


def gql(operation: str, variables: dict[str, Any], query_hash: str) -> dict[str, Any]:
    params = {
        "app_id": "os2-web",
        "operationName": operation,
        "variables": json.dumps(variables, separators=(",", ":")),
        "extensions": json.dumps({"persistedQuery": {"sha256Hash": query_hash, "version": 1}}, separators=(",", ":")),
    }
    r = request_with_retry("GET", GQL, params=params)
    payload = r.json()
    if payload.get("errors"):
        raise RuntimeError(f"GraphQL {operation} errors: {json.dumps(payload['errors'])[:2000]}")
    if not isinstance(payload.get("data"), dict):
        raise RuntimeError(f"GraphQL {operation} missing data: {json.dumps(payload)[:2000]}")
    return payload


def capture_collection_page() -> dict[str, Any]:
    r = request_with_retry("GET", COLLECTION_URL, headers={
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/151 Safari/537.36",
    })
    html = r.text
    (OUT / "raw" / "collection_page.html").write_text(html, encoding="utf-8")
    result: dict[str, Any] = {"captured_utc": now_utc(), "url": r.url, "http_status": r.status_code}
    patterns = {
        "floor_native": r'"floorPrice":\{"pricePerItem":\{"token":\{"unit":([0-9.eE+-]+),"symbol":"([^"]+)"',
        "floor_usd": r'"floorPrice":\{"pricePerItem":\{.*?"usd":([0-9.eE+-]+)',
        "unique_item_count": r'"uniqueItemCount":([0-9]+)',
        "total_supply": r'"totalSupply":([0-9]+)',
        "total_volume_native": r'"volume":\{"native":\{"unit":([0-9.eE+-]+).*?"symbol":"([^"]+)"',
        "total_volume_usd": r'"volume":\{"native":\{.*?\},"usd":([0-9.eE+-]+)',
        "listed_item_count": r'"listedItemCount":([0-9]+)',
        "owner_count": r'"ownerCount":([0-9]+)',
    }
    for key, pattern in patterns.items():
        m = re.search(pattern, html)
        if not m:
            result[key] = None
        elif len(m.groups()) == 1:
            raw = m.group(1)
            result[key] = float(raw) if any(c in raw.lower() for c in ".e") else int(raw)
        else:
            result[key] = {"unit": float(m.group(1)), "symbol": m.group(2)}
    # More deterministic extraction around the first collectionBySlug stats block.
    marker = '"collectionBySlug":{"__typename":"Collection","slug":"montrealai"'
    pos = html.find(marker)
    if pos >= 0:
        result["collection_json_context"] = html[pos:pos + 12000]
    write_json(OUT / "normalized" / "collection_snapshot.json", result)
    return result
