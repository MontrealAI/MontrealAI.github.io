{
  "version": "1.0.0",
  "purpose": "forecast a world that may accelerate during the forecast itself",
  "inputs": [
    "question or target",
    "horizon",
    "newest reliable evidence",
    "6–12 month pace comparison",
    "authority and physical constraints"
  ],
  "models": [
    "linear",
    "exponential",
    "accelerating",
    "constrained",
    "regime-change"
  ],
  "scenarios": [
    "base",
    "accelerated",
    "discontinuous"
  ],
  "required_outputs": [
    "current pace and calculations",
    "milestones",
    "bottlenecks",
    "trigger indicators",
    "confidence and assumptions",
    "optimal plan for today’s regime",
    "dated recalculation point"
  ],
  "rule": "Never extrapolate stale timelines."
}
