{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://montreal.ai/schemas/GoalOS.CandidateReleaseManifest.v2.json",
  "title":"GoalOS Candidate Release Manifest v2",
  "type":"object",
  "required":["schema","release_id","mission_id","algorithm","architecture","policy_state_sha256","manifest_sha256","learning_permitted_after_freeze","authority_created"],
  "properties":{
    "schema":{"const":"GoalOS.CandidateReleaseManifest.v2"},
    "release_id":{"type":"string"},
    "mission_id":{"type":"string"},
    "policy_state_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "learning_permitted_after_freeze":{"const":false},
    "authority_created":{"const":"NONE"}
  }
}
