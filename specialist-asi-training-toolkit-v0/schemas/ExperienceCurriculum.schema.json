{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://montreal.ai/schemas/GoalOS.ExperienceCurriculum.v2.json",
  "title":"GoalOS Experience Curriculum v2",
  "type":"object",
  "required":["schema","mission_id","formation_stages","protected_stages","admission_gate","plan_sha256"],
  "properties":{
    "schema":{"const":"GoalOS.ExperienceCurriculum.v2"},
    "mission_id":{"type":"string"},
    "formation_stages":{"type":"array","minItems":1},
    "protected_stages":{"type":"array","minItems":2},
    "admission_gate":{"type":"object"},
    "plan_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
