{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GoalOS.AlgorithmRoute.v2",
  "title": "GoalOS Mission Algorithm Route",
  "type": "object",
  "required": [
    "schema",
    "mission_id",
    "features",
    "selected_core_algorithms",
    "scores",
    "reasons",
    "routing_laws"
  ],
  "properties": {
    "schema": {
      "const": "GoalOS.AlgorithmRoute.v2"
    },
    "mission_id": {
      "type": "string"
    },
    "features": {
      "type": "object"
    },
    "selected_core_algorithms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2
    },
    "scores": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optional_production_adapters": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "routing_laws": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "additionalProperties": true
}