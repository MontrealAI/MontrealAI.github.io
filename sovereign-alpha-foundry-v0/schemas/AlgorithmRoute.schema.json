{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"GoalOS.UVSI3.AlgorithmRoute.v1",
  "title":"GoalOS Mission Algorithm Route",
  "type":"object",
  "required":["schema","mission_id","features","selected_core_algorithms","scores","reasons","governing_rule"],
  "properties":{
    "schema":{"const":"GoalOS.AlgorithmRoute.v1"},
    "mission_id":{"type":"string"},
    "features":{"type":"object"},
    "selected_core_algorithms":{"type":"array","items":{"type":"string"},"minItems":2},
    "scores":{"type":"object","additionalProperties":{"type":"number"}},
    "reasons":{"type":"array","items":{"type":"string"}},
    "optional_production_adapters":{"type":"array","items":{"type":"object"}},
    "governing_rule":{"type":"string"}
  },
  "additionalProperties":true
}
