{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "Impairment Record",
  "required": [
    "schema",
    "missionId",
    "releaseId",
    "materialChange",
    "invalidatedClaims",
    "automaticActions",
    "proofInherited",
    "authorityInherited",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "SuccessorOmega.ImpairmentRecord.v3"
    },
    "proofInherited": {
      "const": false
    },
    "authorityInherited": {
      "const": false
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$id": "ImpairmentRecord.schema.json",
  "$defs": {
    "signature": {
      "type": "object",
      "required": [
        "scheme",
        "purpose",
        "keyId",
        "signedPayloadSha256",
        "valueBase64"
      ],
      "properties": {
        "scheme": {
          "const": "Ed25519"
        },
        "purpose": {
          "type": "string"
        },
        "keyId": {
          "type": "string"
        },
        "signedPayloadSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "valueBase64": {
          "type": "string"
        }
      }
    }
  }
}
