{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montrealai.github.io/asi/schemas/ens-records.schema.json",
  "title": "MCAP-001 ENS Activation Record Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "root", "network", "status", "generated", "records", "deferred", "activationEvidenceRequired", "warning"],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "root": {"type": "string", "pattern": "^[^.]+\\.eth$"},
    "network": {"type": "string", "pattern": "^eip155:[0-9]+$"},
    "status": {"type": "string"},
    "generated": {"type": "string", "format": "date"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value", "class", "required"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "value": {"type": "string"},
          "class": {"enum": ["standard", "custom", "draft-compatible-ensip-26", "draft-compatible-ensip-25"]},
          "required": {"type": "boolean"}
        }
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record", "reason"],
        "properties": {
          "record": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "activationEvidenceRequired": {"type": "array", "items": {"type": "string"}},
    "warning": {"type": "string", "minLength": 20}
  }
}
