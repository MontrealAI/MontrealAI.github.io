{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montrealai.github.io/asi/schemas/registry.schema.json",
  "title": "MCAP-001 Namespace and Succession Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["specification", "version", "generated", "root", "status", "statusVocabulary", "entries", "disclaimer"],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "specification": {"const": "MCAP-001"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generated": {"type": "string", "format": "date"},
    "root": {"type": "string", "pattern": "^[^.]+\\.eth$"},
    "status": {"type": "string"},
    "statusVocabulary": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string"}
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ens", "role", "status", "title", "canonicalUrl", "authority"],
        "properties": {
          "id": {"type": "string", "pattern": "^ens:"},
          "ens": {"type": "string", "pattern": "\\.eth$"},
          "role": {"type": "string"},
          "status": {"type": "string"},
          "title": {"type": "string"},
          "canonicalUrl": {"type": "string", "format": "uri"},
          "manifest": {"type": "string", "format": "uri"},
          "authority": {"type": "string", "pattern": "^A[0-9]+$"},
          "notes": {"type": "string"},
          "controlRequirement": {"type": "string"},
          "predecessor": {"type": ["string", "null"]},
          "candidateCommitment": {"type": ["string", "null"]},
          "proofReference": {"type": ["string", "null"]},
          "admissionReference": {"type": ["string", "null"]}
        }
      }
    },
    "disclaimer": {"type": "string", "minLength": 20}
  }
}
