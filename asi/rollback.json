{
  "specification": "MCAP-001",
  "version": "0.1.0",
  "root": "asi.eth",
  "status": "genesis-policy",
  "principle": "Consequential authority must have a defined stop, revoke, contain and recover path before activation.",
  "triggers": [
    "proof invalidated",
    "policy breach",
    "material undisclosed change",
    "monitoring loss",
    "credential compromise",
    "unexpected consequence above declared ceiling",
    "verifier conflict or evidence-integrity failure"
  ],
  "sequence": [
    "pause affected authority",
    "preserve evidence",
    "record Chronicle event",
    "contain affected interfaces and keys",
    "notify accountable controllers",
    "assess scope and consequence",
    "repair or supersede",
    "requalify before restoration"
  ],
  "activeMechanisms": [],
  "warning": "This publication defines the required policy surface; it does not claim that a production rollback controller is currently deployed."
}
