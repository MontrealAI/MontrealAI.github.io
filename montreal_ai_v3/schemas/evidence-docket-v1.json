{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montrealai.github.io/schemas/evidence-docket-v1.json",
  "title": "MONTREAL.AI Evidence Docket v1",
  "type": "object",
  "required": [
    "record_id",
    "title",
    "evidence_class",
    "claim",
    "sources",
    "proves",
    "does_not_prove",
    "status",
    "sha256"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "evidence_class": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proves": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "does_not_prove": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": true
}
