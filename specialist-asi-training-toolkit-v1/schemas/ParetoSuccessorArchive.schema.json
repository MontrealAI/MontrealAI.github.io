{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://montreal.ai/schemas/goalos/ParetoSuccessorArchive.v1.json",
  "title":"GoalOS Pareto Successor Archive",
  "type":"object",
  "required":["schema","candidate_count","admissible_count","frontier","elites"],
  "properties":{
    "schema":{"const":"GoalOS.ParetoSuccessorArchive.v1"},
    "candidate_count":{"type":"integer","minimum":0},
    "admissible_count":{"type":"integer","minimum":0},
    "frontier":{"type":"array","items":{"type":"object","required":["algorithm_id","objectives"]}},
    "elites":{"type":"object"}
  },
  "additionalProperties":true
}
