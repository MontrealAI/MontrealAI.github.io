{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"GoalOS.UVSI3.AlgorithmSpec.v1",
  "title":"GoalOS Alpha Foundry Algorithm Specification",
  "type":"object",
  "required":["algorithm_id","name","family","description","complexity","training_cost","inference_cost","sovereignty","governance","status"],
  "properties":{
    "algorithm_id":{"type":"string"},"name":{"type":"string"},"family":{"type":"string"},"description":{"type":"string"},
    "complexity":{"type":"number","minimum":0},"training_cost":{"type":"number","minimum":0},"inference_cost":{"type":"number","minimum":0},
    "sovereignty":{"type":"number","minimum":0,"maximum":1},"governance":{"type":"number","minimum":0,"maximum":1},
    "status":{"enum":["core","optional","experimental"]}
  },"additionalProperties":true
}
