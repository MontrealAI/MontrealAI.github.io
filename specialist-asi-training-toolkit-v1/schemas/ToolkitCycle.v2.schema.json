{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://montreal.ai/schemas/GoalOS.SovereignSpecialistASITrainingToolkit.Tournament.v2.json",
  "title":"GoalOS Sovereign Specialist ASI Training Toolkit Cycle v2",
  "type":"object",
  "required":["schema","run_id","mission","router","candidates","champion_id","verdict","fresh_proof","authority_recommendation","verifier_foundry","curriculum","architecture_market","chronicle","manifest_sha256"],
  "properties":{
    "schema":{"const":"GoalOS.SovereignSpecialistASITrainingToolkit.Tournament.v2"},
    "run_id":{"type":"string"},
    "candidates":{"type":"array","minItems":2},
    "fresh_proof":{"type":"object","required":["fresh_proof_non_learning","champion_release_manifest"],"properties":{"fresh_proof_non_learning":{"const":true}}},
    "authority_recommendation":{"type":"object","required":["created"],"properties":{"created":{"const":false}}},
    "manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
