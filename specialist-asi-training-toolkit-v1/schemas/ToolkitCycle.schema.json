{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montreal.ai/schemas/GoalOS.SovereignSpecialistASITrainingInstitution.Tournament.v3.json",
  "title": "GoalOS Sovereign Specialist ASI Training Institution Cycle v3",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "created_at",
    "mission",
    "router",
    "candidates",
    "champion_id",
    "verdict",
    "fresh_proof",
    "authority_recommendation",
    "verifier_foundry",
    "curriculum",
    "architecture_market",
    "mission_compiler_assurance",
    "pareto_successor_archive",
    "proof_capital_stop_loss",
    "independent_proof_decision",
    "assurance",
    "chronicle",
    "manifest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "GoalOS.SovereignSpecialistASITrainingInstitution.Tournament.v3"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "mission": {
      "type": "object",
      "required": [
        "mission_id"
      ]
    },
    "router": {
      "type": "object"
    },
    "candidates": {
      "type": "array",
      "minItems": 2
    },
    "champion_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "minLength": 1
    },
    "fresh_proof": {
      "type": "object",
      "required": [
        "fresh_proof_non_learning",
        "champion_release_manifest"
      ],
      "properties": {
        "fresh_proof_non_learning": {
          "const": true
        }
      }
    },
    "authority_recommendation": {
      "type": "object",
      "required": [
        "created"
      ],
      "properties": {
        "created": {
          "const": false
        }
      }
    },
    "mission_compiler_assurance": {
      "type": "object"
    },
    "pareto_successor_archive": {
      "type": "object"
    },
    "proof_capital_stop_loss": {
      "type": "object"
    },
    "independent_proof_decision": {
      "type": "object",
      "required": [
        "authority_created"
      ],
      "properties": {
        "authority_created": {
          "const": "NONE"
        }
      }
    },
    "assurance": {
      "type": "object",
      "required": [
        "pass"
      ]
    },
    "chronicle": {
      "type": "object"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}