{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montrealai.github.io/goalos-singularity-navigator-omega-agi-club-owner-access/schemas/dual-access-receipt.schema.json",
  "title": "GoalOS + SEIZE Dual-Qualified Access Receipt",
  "description": "Current schema for browser-local access receipts. Receipt protocol 3.3.1 is preserved while version identifies the current product release.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "accessClass",
    "version",
    "product",
    "address",
    "issuedAt",
    "expiresAt",
    "verificationBlock",
    "signature",
    "signatureMode",
    "authorityCreated"
  ],
  "properties": {
    "schema": {
      "const": "goalos-dual-qualified-access/3.3.1"
    },
    "accessClass": {
      "enum": [
        "AGIALPHA_BALANCE_QUALIFIED",
        "AGI_CLUB_DIRECT_OWNER"
      ]
    },
    "version": {
      "const": "v3.4.0-SN5-BI2-VS1"
    },
    "product": {
      "enum": [
        "GoalOS Singularity Navigator Ω",
        "GoalOS Singularity Navigator Ω + SEIZE"
      ]
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "holder": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "chainId": {
      "type": [
        "integer",
        "string"
      ]
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastVerifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "verificationBlock": {
      "type": [
        "integer",
        "string"
      ]
    },
    "initialVerificationBlock": {
      "type": [
        "integer",
        "string"
      ]
    },
    "signature": {
      "type": "string",
      "minLength": 3
    },
    "signatureMode": {
      "enum": [
        "eip712-v4",
        "personal_sign-domain-bound"
      ]
    },
    "authorityCreated": {
      "const": "NONE"
    },
    "serverAuthoritative": {
      "const": false
    },
    "canonicalDeployment": {
      "type": "string"
    },
    "canonicalDeploymentMatch": {
      "type": "boolean"
    },
    "token": {
      "const": "0xA61a3B3a130a9c20768EEBF97E21515A6046a1fA"
    },
    "qualifyingContract": {
      "const": "0xA61a3B3a130a9c20768EEBF97E21515A6046a1fA"
    },
    "minimumBalance": {
      "const": "1000000000000000000000000"
    },
    "observedBalance": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "observedBalanceFormatted": {
      "type": "string"
    },
    "readOnlyVerification": {
      "const": true
    },
    "noTokenTransaction": {
      "const": true
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.club\\.agi\\.eth$"
    },
    "node": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "mode": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "accessClass": {
            "const": "AGIALPHA_BALANCE_QUALIFIED"
          }
        }
      },
      "then": {
        "required": [
          "holder",
          "token",
          "qualifyingContract",
          "minimumBalance",
          "observedBalance",
          "readOnlyVerification",
          "noTokenTransaction"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "accessClass": {
            "const": "AGI_CLUB_DIRECT_OWNER"
          }
        }
      },
      "then": {
        "required": [
          "name",
          "node",
          "mode"
        ]
      }
    }
  ]
}
