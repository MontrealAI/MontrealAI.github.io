{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montreal.ai/schemas/GoalOS_Candidate_Successor_Manifest_v4.schema.json",
  "title": "GoalOS Candidate Successor Manifest v4",
  "description": "Exact frozen complete candidate identity; proof and authority do not inherit across material change.",
  "type": "object",
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "GoalOS.CandidateSuccessorManifest.v4"
    },
    "projectId": {
      "type": "string"
    },
    "candidate": {
      "type": "object"
    },
    "manifestHash": {
      "type": "string"
    },
    "frozenAt": {
      "type": "string"
    },
    "missionHash": {
      "type": "string"
    },
    "environmentVersion": {
      "type": "string"
    },
    "externalAuthorityCreated": {
      "const": "NONE"
    }
  },
  "additionalProperties": true
}
