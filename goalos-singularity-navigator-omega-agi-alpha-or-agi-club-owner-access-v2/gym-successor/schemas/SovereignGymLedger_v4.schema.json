{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montreal.ai/schemas/GoalOS_Sovereign_Gym_Ledger_v4.schema.json",
  "title": "GoalOS Sovereign Gym Ledger v4",
  "description": "",
