    },
    "owner": {
      "type": "string"
    },
    "rightsCleared": {
      "type": "boolean"
    },
    "portableAPI": {
      "type": "boolean"
    },
    "independentCustody": {
      "type": "boolean"
    },
    "protectedCases": {
      "type": "boolean"
    },
    "providerNeutral": {
      "type": "boolean"
    },
    "chronicleIntegrated": {
      "type": "boolean"
    },
    "requalificationEnabled": {
      "type": "boolean"
    },
    "eventSourced": {
      "type": "boolean"
    },
    "environmentVersions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "proofHistory": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "maturity": {
      "pattern": "^G[0-7]$",
      "type": "string"
    },
    "sovereigntyPremium": {
      "type": "number"
    }
