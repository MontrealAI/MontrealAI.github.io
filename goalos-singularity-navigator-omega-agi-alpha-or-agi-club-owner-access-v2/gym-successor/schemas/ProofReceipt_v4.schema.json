{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montreal.ai/schemas/GoalOS_Proof_Receipt_v4.schema.json",
  "title": "GoalOS Proof Receipt v4",
  "description": "Append-only receipt over exact Gym, candidate, observations, actions, tools, humans, value, constraints and verdict.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "type",
    "at",
    "release",
    "hash"
  ],
  "properties": {
    "schema": {
      "const": "GoalOS.ProofReceipt.v4"
    },
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "release": {
      "type": "string"
    },
    "coreFingerprint": {
      "type": "string"
    },
    "data": {
      "type": "object"
    },
    "hash": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
