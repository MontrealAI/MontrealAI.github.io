{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montreal.ai/schemas/GoalOS_EnvironmentSpec_v4.schema.json",
  "title": "GoalOS EnvironmentSpec v4",
  "description": "Versioned executable mission environment; environment is not the candidate or admitted successor.",
  "type": "object",
  "required": [
    "schema",
    "projectId",
    "version",
    "mission",
    "state",
    "observations",
    "actions",
    "constraints"
  ],
  "properties": {
    "schema": {
      "const": "GoalOS.EnvironmentSpec.v4"
    },
    "projectId": {
      "type": "string"
    },
    "missionId": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "mission": {
      "type": "object"
    },
    "state": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scenarioDistribution": {
      "type": "object"
    },
    "seeds": {
      "type": "object"
    },
    "gssOmega": {
      "type": [
        "object",
        "null"
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
