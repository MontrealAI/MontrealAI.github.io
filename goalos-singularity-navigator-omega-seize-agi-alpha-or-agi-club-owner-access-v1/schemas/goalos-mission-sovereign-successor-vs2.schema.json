{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montreal.ai/schemas/goalos-mission-sovereign-successor-vs2.json",
  "title": "GoalOS Mission-Sovereign Successor Record",
  "type": "object",
  "required": [
    "release",
    "access_constitution",
    "successor_manifold",
    "mission_advantage_gradient",
    "specialist_asi_candidate",
    "fresh_successor_proof",
    "admission",
    "production_release_enabled"
  ],
  "properties": {
    "release": {
      "const": "v3.5.0-SN5-BI2-VS2"
    },
    "access_constitution": {
      "type": "object",
      "required": [
        "rule",
        "qualifying_contract",
        "token_threshold",
        "authority_created"
      ],
      "properties": {
        "rule": {
          "const": "Current AGI Club direct owner OR Current direct holder of at least 1,000,000 official AGIALPHA on Ethereum Mainnet"
        },
        "qualifying_contract": {
          "const": "0xA61a3B3a130a9c20768EEBF97E21515A6046a1fA"
        },
        "token_threshold": {
          "const": "1000000"
        },
        "authority_created": {
          "const": "NONE"
        }
      },
      "additionalProperties": true
    },
    "successor_manifold": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "architecture",
          "position"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "architecture": {
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "mission_advantage_gradient": {
      "type": "object",
      "required": [
        "incumbent",
        "best_credible_alternative",
        "direction",
        "magnitude"
      ],
      "properties": {
        "incumbent": {
          "type": "string"
        },
        "best_credible_alternative": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        },
        "magnitude": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "specialist_asi_candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "designation",
        "complete_stack"
      ],
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "designation": {
          "const": "SPECIALIST_ASI_CANDIDATE"
        },
        "complete_stack": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "fresh_successor_proof": {
      "type": "object",
      "required": [
        "gate_pass",
        "mission_dominant",
        "independent_evaluator",
        "fresh_work"
      ],
      "properties": {
        "gate_pass": {
          "type": "boolean"
        },
        "mission_dominant": {
          "type": "boolean"
        },
        "independent_evaluator": {
          "type": "string"
        },
        "fresh_work": {
          "type": "boolean",
          "const": true
        },
        "successor_gain": {
          "type": "number"
        },
        "proof_coverage": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "admission": {
      "type": "object",
      "required": [
        "disposition",
        "designation",
        "authority_scope",
        "revocable"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "admit",
            "admit_with_limits",
            "repair",
            "reject",
            "expire",
            "revoke",
            "retire"
          ]
        },
        "designation": {
          "enum": [
            "MISSION_SOVEREIGN_SUCCESSOR",
            "NONE"
          ]
        },
        "authority_scope": {
          "enum": [
            "SCOPED_REVOCABLE",
            "NONE"
          ]
        },
        "revocable": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "production_release_enabled": {
      "type": "boolean",
      "const": false
    }
  },
  "additionalProperties": true
}
