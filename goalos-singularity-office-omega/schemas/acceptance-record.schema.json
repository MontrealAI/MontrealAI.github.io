{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montreal.ai/schemas/goalos-office-acceptance-v1.json",
  "title": "GoalOS Office Production Acceptance Record",
  "type": "object",
  "required": [
    "release",
    "operator",
    "origin",
    "executedAt",
    "cases"
  ],
  "properties": {
    "release": {
      "const": "v2.0.0-SO2"
    },
    "operator": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "executedAt": {
      "type": "string"
    },
    "cases": {
      "type": "array"
    }
  }
}