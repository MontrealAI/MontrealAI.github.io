{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montreal.ai/schemas/goalos-publisher-public-key-v1.json",
  "title": "GoalOS Publisher Public Key",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kty",
    "crv",
    "x",
    "y",
    "key_ops",
    "ext"
  ],
  "properties": {
    "kty": {
      "const": "EC"
    },
    "crv": {
      "const": "P-256"
    },
    "x": {
      "type": "string"
    },
    "y": {
      "type": "string"
    },
    "key_ops": {
      "const": [
        "verify"
      ]
    },
    "ext": {
      "const": true
    }
  }
}
