{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montreal.ai/schemas/goalos-office-state-v1.json",
  "title": "GoalOS Singularity Office State",
  "type": "object",
  "required": [
    "release",
    "workspaceId",
    "profile",
    "auction",
    "missions",
    "proofDebt",
    "ledger"
  ],
  "properties": {
    "release": {
      "const": "v2.0.0-SO2"
    },
    "workspaceId": {
      "type": "string"
    },
    "profile": {
      "type": "object"
    },
    "auction": {
      "type": "object"
    },
    "missions": {
      "type": "array"
    },
    "proofDebt": {
      "type": "array"
    },
    "ledger": {
      "type": "array"
    },
    "chronicle": {
      "type": "array"
    },
    "valueEntries": {
      "type": "array"
    }
  }
}