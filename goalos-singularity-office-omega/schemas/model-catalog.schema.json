{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montreal.ai/schemas/goalos-model-catalog-v1.json",
  "title": "GoalOS Signed Model and Execution-Stack Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "catalogId",
    "product",
    "release",
    "issuedAt",
    "models",
    "signature",
    "signatureAlgorithm",
    "publicKeyId"
  ],
  "properties": {
    "schema": {
      "const": "goalos.model-catalog.v1"
    },
    "catalogId": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "const": "GoalOS Singularity Office Ω"
    },
    "release": {
      "const": "v2.0.0-SO2"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "provider",
          "class",
          "privacy",
          "evidence",
          "reasoning",
          "speed",
          "cost",
          "tooling",
          "resilience",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "type": "string",
            "minLength": 1
          },
          "privacy": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "evidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "reasoning": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "speed": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "cost": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "tooling": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "resilience": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "signature": {
      "type": "string",
      "minLength": 16
    },
    "signatureAlgorithm": {
      "const": "ECDSA-P256-SHA256"
    },
    "publicKeyId": {
      "type": "string",
      "minLength": 1
    }
  }
}
