{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montrealai.github.io/schemas/goalos-agi-club-owner-access-receipt-v2.json",
  "title": "GoalOS AGI Club Direct Owner Access Receipt",
  "type": "object",
  "required": [
    "schema",
    "version",
    "product",
    "name",
    "address",
    "node",
    "mode",
    "issuedAt",
    "expiresAt",
    "verificationBlock",
    "message",
    "signature",
    "protectionBoundary"
  ],
  "properties": {
    "schema": {
      "const": "goalos-agi-club-owner-access/2.0"
    },
    "version": {
      "type": "string"
    },
    "product": {
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.club\\.agi\\.eth$"
    },
    "address": {
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "node": {
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "mode": {
      "enum": [
        "ENS Registry direct owner",
        "ENS Name Wrapper ERC-1155 direct owner"
      ]
    },
    "issuedAt": {
      "format": "date-time"
    },
    "expiresAt": {
      "format": "date-time"
    },
    "verificationBlock": {
      "type": "integer",
      "minimum": 1
    },
    "message": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    },
    "protectionBoundary": {
      "type": "string"
    }
  }
}
