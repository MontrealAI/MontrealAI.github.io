{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoalOS SN5 Proof Bundle",
  "type": "object",
  "required": [
    "schema",
    "product",
    "version",
    "generatedAt",
    "state",
    "integrity"
  ],
  "properties": {
    "schema": {
      "const": "goalos-singularity-navigator-proof-bundle/3.0"
    },
    "version": {
      "const": "v3.1.0-SN5-LR1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "object"
    },
    "integrity": {
      "type": "object",
      "required": [
        "hashAlgorithm",
        "digest"
      ]
    }
  }
}