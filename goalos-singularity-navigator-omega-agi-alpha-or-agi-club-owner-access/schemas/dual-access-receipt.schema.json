{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montrealai.github.io/goalos-singularity-navigator-omega-agi-club-owner-access/schemas/dual-access-receipt.schema.json",
  "title": "GoalOS Dual-Access Receipt",
  "type": "object",
  "required": [
    "release",
    "accessClass",
    "holder",
    "chainId",
    "issuedAt",
    "expiresAt",
    "signature",
    "signatureMethod",
    "authorityCreated"
  ],
  "properties": {
    "release": {
      "const": "v3.3.1-SN5-BI2"
    },
    "accessClass": {
      "enum": [
        "AGIALPHA_BALANCE_QUALIFIED",
        "AGI_CLUB_DIRECT_OWNER"
      ]
    },
    "holder": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "chainId": {
      "const": 1
    },
    "token": {
      "const": "0xA61a3B3a130a9c20768EEBF97E21515A6046a1fA"
    },
    "qualifyingContract": {
      "const": "0xA61a3B3a130a9c20768EEBF97E21515A6046a1fA"
    },
    "minimumBalance": {
      "const": "1000000000000000000000000"
    },
    "observedBalance": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "verificationBlock": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "issuedAt": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "expiresAt": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "origin": {
      "type": "string"
    },
    "legalDigest": {
      "const": "0x286db7afa2ad5e9042ef31aa6331a301dd89407832d56cced000c7c3a06dbf3a"
    },
    "authority": {
      "const": "NONE"
    },
    "authorityCreated": {
      "const": "NONE"
    },
    "signature": {
      "type": "string",
      "pattern": "^0x"
    },
    "signatureMethod": {
      "enum": [
        "EIP-712",
        "personal_sign"
      ]
    },
    "localReceiptOnly": {
      "const": true
    }
  },
  "additionalProperties": true
}
